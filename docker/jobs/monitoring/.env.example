# Shared variables used in docker-compose volume mounts
# Docker Compose auto-loads this file for variable substitution
# Copy this file to .env and set values for your local setup

# Access to the external tools library (label-backfill, register-benchmark)
TOOLS_LIB_PATH=/path/to/tools

# Drive mount path (host path to O: drive), used by register-benchmark to
# read benchmark image files
O_DRIVE_PATH=/mnt/O
