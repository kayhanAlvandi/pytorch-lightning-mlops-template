# Monitoring job environment variables to be set inside container
# Copy this file to .env.monitoring and set values for your local setup

# Postgres connection (same DB the API / compute-reference write to)
MONITORING_DB_URI=postgresql://postgres:postgres@postgres:5432/image_classifier

# Base URL of the running API, used to read the served model's run_id from
# /model when --run-id is not passed. 'api' is the compose service name of the
# API, reachable on the shared docker networks.
MONITORING_BASE_URL=http://api:8000
